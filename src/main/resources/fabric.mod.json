{
  "schemaVersion": 1,
  "id": "yet_another_bingo_kits",
  "version": "${version}",
  "name": "Yet Another Bingo - Kits",
  "description": "Add kits to Yet Another Bingo",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "me.chengzhify.client.yabbingokitsDataGenerator"
    ],
    "main": [
      "me.chengzhify.YABBingoKits"
    ]
  },
  "mixins": [
    "yet_another_bingo_kits.mixins.json",
    {
      "config": "yet_another_bingo_kits.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "yet-another-minecraft-bingo": ">=${bingo_version}",
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  }
}
